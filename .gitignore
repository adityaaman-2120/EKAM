# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
pytest-junit.xml

# Project runtime data
data/runtime/

# Node / frontend
node_modules/

# Environment / secrets
.env
.env.*

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local assistant context — not for the public repo
CLAUDE.md
.claude/

# Local dev TLS material (generated by deploy/certs/generate_dev_certs.sh)
deploy/certs/*.crt
deploy/certs/*.key
deploy/certs/*.csr
deploy/certs/*.srl

# MaxMind GeoLite2 databases — licence-restricted, obtained out of band, and
# NEVER committed to this repository (see deploy/data/README.md)
*.mmdb
deploy/data/*.mmdb

# Ed25519 signing keys — the private key never leaves the host; only the public
# key is committed (see `ulpf keys generate`).
deploy/keys/*.pem
!deploy/keys/*_public.pem

check_parse.py

# Generated by tests/test_phase5_integrity.py (machine-specific timings)
bench/integrity_overhead.txt
